---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";
import { buttonVariants } from "@/components/ui/button";
import { authErrorMessage } from "@/lib/auth-errors";
import { cn } from "@/lib/utils";

// The same for every address, with an account or without one: this screen must not tell which.
const sent = Astro.url.searchParams.get("wyslano") === "1";
const code = Astro.url.searchParams.get("error");
// Only a known code becomes a message; any other text in the link shows the generic one, never itself.
// The shared text of `validation_failed` also speaks of a password, which this form does not have.
const error = code === "validation_failed" ? "Podaj adres e-mail i spróbuj ponownie." : authErrorMessage(code);
const title = sent ? "Sprawdź skrzynkę" : "Reset hasła";
---

<Layout title={title}>
  <AuthShell title={title}>
    {sent ? (
      <p role="status" class="text-foreground text-sm">
        Jeśli konto z tym adresem istnieje, wysłaliśmy na nie link do ustawienia nowego hasła. Link jest ważny godzinę.
      </p>
    ) : (
      <Fragment>
        <p class="text-muted-foreground mb-4 text-sm">
          Podaj adres e-mail swojego konta, żeby dostać link do ustawienia nowego hasła.
        </p>
        <ForgotPasswordForm serverError={error} client:load />
      </Fragment>
    )}
    <a slot="footer" href="/auth/signin" class:list={[cn(buttonVariants({ variant: "link" }), "h-auto px-1 py-2")]}>
      Wróć do logowania
    </a>
  </AuthShell>
</Layout>
