---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import { buttonVariants } from "@/components/ui/button";
import { authErrorMessage } from "@/lib/auth-errors";
import { cn } from "@/lib/utils";
import SignUpForm from "@/components/auth/SignUpForm";

// Only a known code becomes a message; any other text in the link shows the generic one, never itself.
const error = authErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title="Załóż konto">
  <AuthShell title="Załóż konto">
    <SignUpForm serverError={error} client:load />
    <Fragment slot="footer">
      <span class="text-muted-foreground text-sm">Masz już konto?</span>
      <a href="/auth/signin" class:list={[cn(buttonVariants({ variant: "link" }), "h-auto px-1 py-2")]}>
        Zaloguj się
      </a>
    </Fragment>
  </AuthShell>
</Layout>
