---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
---

<Layout title="Sprawdź skrzynkę">
  <AuthShell title="Sprawdź skrzynkę">
    <p class="text-foreground text-sm">
      Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, żeby aktywować konto, a potem się zaloguj.
    </p>
    <a slot="footer" href="/auth/signin" class:list={[cn(buttonVariants({ variant: "link" }), "h-auto px-1 py-2")]}>
      Wróć do logowania
    </a>
  </AuthShell>
</Layout>
