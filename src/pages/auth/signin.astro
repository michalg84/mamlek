---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import { buttonVariants } from "@/components/ui/button";
import { authErrorMessage } from "@/lib/auth-errors";
import { cn } from "@/lib/utils";
import SignInForm from "@/components/auth/SignInForm";

// Only a known code becomes a message; any other text in the link shows the generic one, never itself.
const error = authErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title="Zaloguj się">
  <AuthShell title="Zaloguj się">
    <SignInForm serverError={error} client:load />
    <div class="mt-2 text-center">
      <a href="/auth/forgot-password" class:list={[cn(buttonVariants({ variant: "link" }), "h-auto px-1 py-2")]}>
        Nie pamiętasz hasła?
      </a>
    </div>
    <Fragment slot="footer">
      <span class="text-muted-foreground text-sm">Nie masz konta?</span>
      <a href="/auth/signup" class:list={[cn(buttonVariants({ variant: "link" }), "h-auto px-1 py-2")]}>
        Załóż konto
      </a>
    </Fragment>
  </AuthShell>
</Layout>
