---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { ServerError } from "@/components/auth/ServerError";
import { buttonVariants } from "@/components/ui/button";
import { authErrorMessage, sessionCheckFailure } from "@/lib/auth-errors";
import { resetPageState, type RecoveryRead } from "@/lib/password-reset";
import { createRecoveryClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";

// The URL can hold the one-time token: a referrer carries the origin only, and no cache keeps the page. Not
// `no-referrer`: the form would then post `Origin: null`, which Astro's `security.checkOrigin` rejects.
Astro.response.headers.set("Referrer-Policy", "strict-origin");
Astro.response.headers.set("Cache-Control", "no-store");

const code = Astro.url.searchParams.get("error");
// An empty value counts as no token, here as in `resetPageState` and the endpoint.
const tokenHash = Astro.url.searchParams.get("token_hash");

/** Reads the session in the recovery cookie. A token refresh may rewrite that cookie, so this runs in the page. */
async function readRecoverySession(): Promise<RecoveryRead> {
  const recovery = createRecoveryClient(Astro.request, Astro.cookies);
  // Without configuration nothing is known about the link, so it must not read as expired.
  if (!recovery) {
    return { kind: "outage" };
  }
  const { data, error } = await recovery.client.auth.getUser();
  if (!error) {
    return { kind: "user", email: data.user.email ?? "" };
  }
  const failure = sessionCheckFailure(error);
  if (failure !== "none") {
    // A missing session is the normal visit without a link; anything else is logged with its cause.
    // eslint-disable-next-line no-console -- a failed session check must reach the log, not look like an expired link
    console.error(`Recovery session check failed (${failure})`, error);
  }
  return { kind: failure === "outage" ? "outage" : "none" };
}

// Opening a link must not use it up (mail scanners follow links), so a GET never calls `verifyOtp`; with a token in
// the URL the cookie is not even read.
const session: RecoveryRead = tokenHash ? { kind: "none" } : await readRecoverySession();
const state = resetPageState({ error: code, tokenHash, session });

// Only a known code becomes a message; any other text in the link shows the generic one, never itself.
// The shared text of `validation_failed` speaks of an e-mail address, which this form does not have.
const error =
  code === "validation_failed" ? "Wpisz nowe hasło w obu polach i spróbuj ponownie." : authErrorMessage(code);
const titles = {
  invalid_link: "Link nieważny",
  token_form: "Ustaw nowe hasło",
  session_form: "Ustaw nowe hasło",
  unavailable: "Chwilowo niedostępne",
} as const;
const title = titles[state.kind];
---

<Layout title={title}>
  <AuthShell title={title}>
    {state.kind === "token_form" && <ResetPasswordForm tokenHash={state.tokenHash} serverError={error} client:load />}
    {state.kind === "session_form" && <ResetPasswordForm email={state.email} serverError={error} client:load />}
    {state.kind === "invalid_link" && (
      <div class="space-y-4">
        <ServerError message={authErrorMessage("otp_expired")} />
        <a href="/auth/forgot-password" class:list={[buttonVariants(), "min-h-11 w-full"]}>
          Poproś o nowy link
        </a>
      </div>
    )}
    {state.kind === "unavailable" && (
      <div class="space-y-4">
        <ServerError message="Nie udało się sprawdzić linku — serwis jest chwilowo niedostępny. Spróbuj ponownie za chwilę." />
        <a href="/auth/reset-password" class:list={[buttonVariants(), "min-h-11 w-full"]}>
          Spróbuj ponownie
        </a>
      </div>
    )}
    <a slot="footer" href="/auth/signin" class:list={[cn(buttonVariants({ variant: "link" }), "h-auto px-1 py-2")]}>
      Wróć do logowania
    </a>
  </AuthShell>
</Layout>
