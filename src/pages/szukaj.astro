---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { Card, CardContent } from "@/components/ui/card";
import { CircleAlert } from "lucide-react";
import RegistrySearch from "@/components/registry/RegistrySearch";
import { createClient } from "@/lib/supabase";
import { getSearchListVersion } from "@/lib/services/registry-search-list";
import type { RegistrySearchListVersion } from "@/types";

let list: RegistrySearchListVersion | null = null;
let failed = false;
try {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    list = await getSearchListVersion(supabase);
  } else {
    failed = true;
  }
} catch (error) {
  // Typically the app deployed before the migration reached the database; show a message instead of a 500 page.
  failed = true;
  // eslint-disable-next-line no-console -- the only trace of the failure; the page shows a generic message
  console.error(error);
}
---

<Layout title="Szukaj leku">
  {list && (
    // Same URL, mode and credentials as the fetch in useRegistrySearch, so the browser reuses this download.
    <link
      slot="head"
      rel="preload"
      href={`/api/registry/search-list?v=${list.version}`}
      as="fetch"
      crossorigin="anonymous"
    />
  )}
  <div class="min-h-screen p-4">
    <div class="mx-auto w-full max-w-xl min-w-0">
      <Topbar />
      <main class="min-w-0">
        <Card>
          <CardContent className="min-w-0">
            <h1 class="text-foreground mb-4 text-2xl font-bold">Szukaj leku</h1>
            {failed ? (
              <p class="text-destructive flex items-start gap-1.5 text-sm font-medium">
                <CircleAlert aria-hidden="true" className="mt-0.5 size-4 shrink-0" />
                <span class="min-w-0">Nie udało się wczytać rejestru leków, spróbuj później</span>
              </p>
            ) : list ? (
              <RegistrySearch version={list.version} client:load />
            ) : (
              <p class="text-muted-foreground text-sm">Rejestr leków nie jest jeszcze wczytany</p>
            )}
          </CardContent>
        </Card>
      </main>
    </div>
  </div>
</Layout>
