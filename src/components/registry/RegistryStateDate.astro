---
import { TriangleAlert } from "lucide-react";
import { cn } from "@/lib/utils";
import { formatRegistryDate, isRegistryStale } from "@/lib/registry-date";

interface Props {
  snapshotDate: string;
  // Today as `YYYY-MM-DD` in the app's timezone (todayIso("Europe/Warsaw")).
  today: string;
  class?: string;
}

const { snapshotDate, today, class: className } = Astro.props;
const stale = isRegistryStale(snapshotDate, today);
const date = formatRegistryDate(snapshotDate);
---

{stale ? (
  <p
    role="status"
    class:list={cn(
      "bg-warning text-warning-foreground flex items-start gap-1.5 rounded-md px-3 py-2 text-xs font-medium",
      className,
    )}
  >
    <TriangleAlert aria-hidden="true" className="mt-0.5 size-4 shrink-0" />
    <span class="min-w-0">Stan rejestru na {date} — dane mogą być nieaktualne</span>
  </p>
) : (
  <p class:list={cn("text-muted-foreground text-xs", className)}>Stan rejestru na {date}</p>
)}
