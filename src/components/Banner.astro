---
import { cn } from "@/lib/utils";

type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div
  class:list={[
    cn(
      "border-b px-4 py-3 text-center text-sm",
      "[&_a]:rounded-sm [&_a]:font-semibold [&_a]:text-inherit [&_a]:underline",
      "[&_a]:focus-visible:outline-none [&_a]:focus-visible:ring-2 [&_a]:focus-visible:ring-ring",
      variant === "error" && "border-destructive bg-destructive/10 text-destructive",
      variant === "warning" && "border-warning bg-warning text-warning-foreground",
      variant === "info" && "border-border bg-muted text-foreground",
    ),
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
