---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const { user } = Astro.locals;
const linkClass = cn(buttonVariants({ variant: "link" }), "h-auto px-2 py-1");
const onSearch = Astro.url.pathname === "/szukaj";
const onKit = Astro.url.pathname === "/apteczka";
---

<div class="bg-card mb-4 flex items-center justify-between gap-3 rounded-xl border px-4 py-2 text-sm">
  {user ? (
    <>
      <span class="text-muted-foreground min-w-0 truncate">{user.email}</span>
      <div class="flex shrink-0 items-center gap-1">
        <a href="/szukaj" class:list={linkClass} aria-current={onSearch ? "page" : undefined}>
          Szukaj leku
        </a>
        <a href="/apteczka" class:list={linkClass} aria-current={onKit ? "page" : undefined}>
          Apteczka
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class:list={linkClass}>
            Wyloguj
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground min-w-0 truncate">Nie zalogowano</span>
      <div class="flex shrink-0 items-center gap-1">
        <a href="/auth/signin" class:list={linkClass}>
          Zaloguj się
        </a>
        <a href="/auth/signup" class:list={linkClass}>
          Załóż konto
        </a>
      </div>
    </>
  )}
</div>
